generator client { provider = "prisma-client-js" } datasource db { provider = "postgresql" url = env("DATABASE_URL") } model Wallet { id String @id @default(uuid()) userId String @unique balance Decimal @db.Decimal(19, 4) version Int @default(0) transactions Transaction[] } model Transaction { id String @id @default(uuid()) walletId String wallet Wallet @relation(fields: [walletId], references: [id]) amount Decimal @db.Decimal(19, 4) createdAt DateTime @default(now()) }